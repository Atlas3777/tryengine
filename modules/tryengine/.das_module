options gen2
require daslib/fio

[export]
def initialize(project_path : string) {
    if (das_is_dll_build()) {
        register_dynamic_module("{project_path}/tryengine.shared_module", "Module_Renderer")
        register_dynamic_module("{project_path}/tryengine.shared_module", "Module_Resources")
        register_dynamic_module("{project_path}/tryengine.shared_module", "Module_Input")
        register_dynamic_module("{project_path}/tryengine.shared_module", "Module_AsyncFileManager")
    }
}